{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy-scout.dev/schemas/region-drift/v1",
  "title": "Policy Scout Region drift report schema v1",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1" },
    "summary": {
      "type": "object",
      "properties": {
        "accounts": { "type": "integer", "minimum": 0 },
        "restricted": { "type": "integer", "minimum": 0 },
        "unrestricted": { "type": "integer", "minimum": 0 },
        "with_blind_spots": { "type": "integer", "minimum": 0 },
        "with_uninterpretable_restrictions": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "accounts",
        "restricted",
        "unrestricted",
        "with_blind_spots",
        "with_uninterpretable_restrictions",
        "excluded"
      ]
    },
    "accounts": { "type": "array", "items": { "$ref": "#/$defs/accountResult" } },
    "excluded_accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": { "$ref": "#/$defs/account" },
          "path": { "$ref": "#/$defs/path" },
          "reason": { "enum": ["management_account", "inactive_account"] }
        },
        "required": ["account", "path", "reason"]
      }
    }
  },
  "required": ["schema_version", "summary", "accounts", "excluded_accounts"],
  "$defs": {
    "entity": {
      "type": "object",
      "properties": {
        "type": { "enum": ["root", "organizational_unit", "account"] },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" }
      },
      "required": ["type", "id"]
    },
    "path": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/entity" },
      "prefixItems": [{ "properties": { "type": { "const": "root" } } }]
    },
    "account": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{12}$" },
        "name": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "name"]
    },
    "regions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "values": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "category": {
      "enum": [
        "principal",
        "principal_account",
        "principal_organization",
        "principal_tag",
        "region",
        "resource_owner",
        "resource_tag",
        "request_tag",
        "network",
        "service_call",
        "other"
      ]
    },
    "exemption": {
      "type": "object",
      "properties": {
        "source": { "enum": ["condition", "not_action", "not_resource", "statement"] },
        "category": { "$ref": "#/$defs/category" },
        "operator": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "values": { "$ref": "#/$defs/values" },
        "exempt_when": {
          "enum": ["matches_values", "does_not_match_values", "key_present", "key_absent"]
        },
        "exempt_if_key_absent": { "type": "boolean" },
        "interpretable": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["source", "interpretable"],
      "oneOf": [
        {
          "properties": { "source": { "const": "condition" }, "interpretable": { "const": true } },
          "required": ["category", "operator", "key", "values", "exempt_when", "exempt_if_key_absent"],
          "not": { "required": ["reason"] }
        },
        {
          "properties": {
            "source": { "enum": ["not_action", "not_resource"] },
            "interpretable": { "const": true },
            "exempt_when": { "const": "matches_values" }
          },
          "required": ["values", "exempt_when"],
          "not": {
            "anyOf": [
              { "required": ["category"] },
              { "required": ["operator"] },
              { "required": ["key"] },
              { "required": ["exempt_if_key_absent"] },
              { "required": ["reason"] }
            ]
          }
        },
        {
          "properties": { "interpretable": { "const": false } },
          "required": ["reason"],
          "not": {
            "anyOf": [{ "required": ["exempt_when"] }, { "required": ["exempt_if_key_absent"] }]
          }
        }
      ]
    },
    "restriction": {
      "type": "object",
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "policy_name": { "type": "string", "minLength": 1 },
        "attached_to": { "$ref": "#/$defs/entity" },
        "inherited": { "type": "boolean" },
        "statement_index": { "type": "integer", "minimum": 0 },
        "sid": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["allow_list", "deny_list"] },
        "operator": { "type": "string" },
        "regions": { "$ref": "#/$defs/values" },
        "carve_outs": { "type": "array", "items": { "$ref": "#/$defs/exemption" } }
      },
      "required": [
        "policy_id",
        "policy_name",
        "attached_to",
        "inherited",
        "statement_index",
        "kind",
        "operator",
        "regions",
        "carve_outs"
      ],
      "if": { "properties": { "kind": { "const": "allow_list" } } },
      "then": {
        "properties": {
          "operator": { "pattern": "^String(NotEquals|NotEqualsIgnoreCase|NotLike)(IfExists)?$" }
        }
      },
      "else": {
        "properties": {
          "operator": { "pattern": "^String(Equals|EqualsIgnoreCase|Like)(IfExists)?$" }
        }
      }
    },
    "uninterpretable": {
      "type": "object",
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "policy_name": { "type": "string", "minLength": 1 },
        "attached_to": { "$ref": "#/$defs/entity" },
        "inherited": { "type": "boolean" },
        "statement_index": { "type": "integer", "minimum": 0 },
        "sid": { "type": "string", "minLength": 1 },
        "operator": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "values": { "$ref": "#/$defs/values" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["policy_id", "policy_name", "attached_to", "inherited", "statement_index", "reason"]
    },
    "enabledRegion": {
      "type": "object",
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "opt_status": { "enum": ["ENABLED", "ENABLED_BY_DEFAULT", "ENABLING", "DISABLING"] }
      },
      "required": ["region", "opt_status"]
    },
    "accountResult": {
      "type": "object",
      "properties": {
        "account": { "$ref": "#/$defs/account" },
        "path": { "$ref": "#/$defs/path" },
        "no_region_restriction": { "type": "boolean" },
        "enabled_regions": { "type": "array", "items": { "$ref": "#/$defs/enabledRegion" } },
        "enabled_allowed_regions": { "$ref": "#/$defs/regions" },
        "blind_spot_regions": { "$ref": "#/$defs/regions" },
        "enabled_denied_regions": { "$ref": "#/$defs/regions" },
        "allowed_disabled_regions": { "$ref": "#/$defs/regions" },
        "restrictions": { "type": "array", "items": { "$ref": "#/$defs/restriction" } },
        "uninterpretable_restrictions": { "type": "array", "items": { "$ref": "#/$defs/uninterpretable" } }
      },
      "required": [
        "account",
        "path",
        "no_region_restriction",
        "enabled_regions",
        "enabled_allowed_regions",
        "blind_spot_regions",
        "enabled_denied_regions",
        "allowed_disabled_regions",
        "restrictions",
        "uninterpretable_restrictions"
      ],
      "if": { "properties": { "no_region_restriction": { "const": true } } },
      "then": {
        "properties": {
          "restrictions": { "maxItems": 0 },
          "enabled_allowed_regions": { "maxItems": 0 },
          "enabled_denied_regions": { "maxItems": 0 },
          "allowed_disabled_regions": { "maxItems": 0 }
        }
      },
      "else": { "properties": { "restrictions": { "minItems": 1 } } }
    }
  }
}
